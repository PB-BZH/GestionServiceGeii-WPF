<Window x:Class="GestionServiceGeii.UI.Windows.ProfilePathsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionServiceGeii.UI.Windows"
        mc:Ignorable="d"
        Title="Configuration des chemins du profil"
        Height="280"
        Width="620">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="32" />
            </Grid.ColumnDefinitions>
            
            <Label x:Name="lblListsWorkbookPath"
                   Content="Fichier de sélection"
                   Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center" />
            
            <TextBox x:Name="txtListsWorkbookPath"
                     Grid.Row="0"
                     Grid.Column="2"
                     VerticalAlignment="Center"
                     Height="25" />
            
            <Button x:Name="btnBrowseListsWorkbook"
                    Grid.Row="0"
                    Grid.Column="4"
                    Height="25"
                    Content="..."
                    Click="btnBrowseListsWorkbook_Click" />

            <Label x:Name="lblServiceWorkbookPath"
                   Content="Fichier de service"
                   Grid.Row="1"
                   Grid.Column="0"
                   VerticalAlignment="Center" />

            <TextBox x:Name="txtServiceWorkbookPath"
                     Grid.Row="1"
                     Grid.Column="2"
                     VerticalAlignment="Center"
                     Height="25" />

            <Button x:Name="btnbtnBrowseServiceWorkbook"
                    Grid.Row="1"
                    Grid.Column="4"
                    Height="25"
                    Content="..."
                    Click="btnBrowseServiceWorkbook_Click" />

            <Label x:Name="lblBackupDirectory"
                   Content="Dossier de sauvegarde"
                   Grid.Row="2"
                   Grid.Column="0"
                   VerticalAlignment="Center" />

            <TextBox x:Name="txtBackupDirectory"
                     Grid.Row="2"
                     Grid.Column="2"
                     VerticalAlignment="Center"
                     Height="25" />

            <Button x:Name="btnBackupDirectory"
                    Grid.Row="2"
                    Grid.Column="4"
                    Height="25"
                    Content="..."
                    Click="btnBrowseBackupDirectory_Click" />

            <Label x:Name="lblExportDirectory"
                   Content="Dossier d’export"
                   Grid.Row="3"
                   Grid.Column="0"
                   VerticalAlignment="Center" />

            <TextBox x:Name="txtExportDirectory"
                     Grid.Row="3"
                     Grid.Column="2"
                     VerticalAlignment="Center"
                     Height="25" />

            <Button x:Name="btnExportDirectory"
                    Grid.Row="3"
                    Grid.Column="4"
                    Height="25"
                    Content="..."
                    Click="btnBrowseExportDirectory_Click"
                    Margin="0,4,0,0"
                    VerticalAlignment="Top" />
            
        </Grid>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button x:Name="btnOk"
                    Content="OK"
                    Height="25"
                    Width="80"
                    Margin="5,0"
                    Click="btnOk_Click" />

            <Button x:Name="btnCancel"
                    Content="Annuler"
                    Height="25"
                    Width="80"
                    Margin="5,0"
                    Click="btnCancel_Click" />

        </StackPanel>
    </Grid>
</Window>
