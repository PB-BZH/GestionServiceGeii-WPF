<Window x:Class="GestionServiceGeii.UI.Windows.ChoixSuppressionGroupe"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suppression d'un groupe"
        Width="500"
        Height="220"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="15" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Content="Intervenant"
                   VerticalAlignment="Center" />

            <TextBox x:Name="TxtIntervenant"
                     Grid.Column="1"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center" />

            <Label Grid.Column="3"
                   Content="Cours"
                   VerticalAlignment="Center" />

            <TextBox x:Name="TxtCours"
                     Grid.Column="4"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Content="Choix du groupe à supprimer"
                   VerticalAlignment="Center" />

            <ComboBox x:Name="CbChoixGroupe"
                      Grid.Column="1"
                      MinWidth="150"
                      VerticalContentAlignment="Center" />
        </Grid>

        <Button x:Name="BtnValider"
                Grid.Row="6"
                Width="120"
                Height="32"
                HorizontalAlignment="Right"
                Content="Valider"
                Click="BtnValider_Click" />
    </Grid>
</Window>