                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtTd1_FI"
                                   Text="TD1"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="5,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <CheckBox x:Name="ChkESE"
                                      Content="ESE"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkEME"
                                      Content="EME"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkAII"
                                      Content="AII"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Effectif : "
                                   Grid.Row="0"
                                   Grid.Column="4"
                                   VerticalAlignment="Center" />

                        <TextBox x:Name="txtTotalTD1_FI"
                                 Grid.Row="0"
                                 Width="Auto"
                                 Grid.Column="6"
                                 VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center" />

                        <TextBox x:Name="txtTd2_FI"
                                 Text="TD2"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 Width="50"
                                 VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="5,0"
                                    Grid.Column="2"
                                    Orientation="Horizontal">
                            <CheckBox x:Name="ChkESE_2"
                                      Content="ESE"
                                      Margin="0,0,10,0"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkEME_2"
                                      Content="EME"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkAII_2"
                                      Content="AII"
                                      Margin="10,0,0,0"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
