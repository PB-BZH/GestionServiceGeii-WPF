                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="tbkTpCommunAii22_Fi"
                                       Text="AII22_Fi"
                                       Grid.Column="0"
                                       Grid.Row="5"
                                       Margin="5,0"
                                       VerticalAlignment="Center" />
                            <CheckBox x:Name="chkTP16_Fi"
                                      Content="TP1"
                                      Grid.Column="1"
                                      Grid.Row="5"
                                      Style="{StaticResource Effectif_Fi_CheckBox}" />

                            <CheckBox x:Name="chkTP26_Fi"
                                      Content="TP2"
                                      Grid.Column="2"
                                      Grid.Row="5"
                                      Style="{StaticResource Effectif_Fi_CheckBox}" />

                            <CheckBox x:Name="chkTP36_Fi"
                                      Content="TP3"
                                      Grid.Column="3"
                                      Grid.Row="5"
                                      Style="{StaticResource Effectif_Fi_CheckBox}" />

                            <TextBox x:Name="txtTpCommunAii22_Fi"
                                     Grid.Column="4"
                                     Grid.Row="5"
                                     Style="{StaticResource EffectifTextBoxBase}" />
                                </Grid>
                        </StackPanel>

                    </Grid>
                </GroupBox>
                <GroupBox x:Name="grpRegroupement_TP_Fi"
                          Header="Effectifs des groupes de TP"
                          Grid.Row="1"
                          Margin="5"
                          VerticalAlignment="Center"
                          Grid.Column="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="txtTP1_Fi"
                                   Text="TP1"
                                   Grid.Column="0"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />

                        <TextBox x:Name="txtTP1_officiel_Fi"
                                 Grid.Column="1"
                                 Margin="5,0"
                                 Height="25"
                                 Width="60"
                                 VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center"
                                 HorizontalAlignment="Center" />

                        <TextBlock x:Name="txtTP2_Fi"
                                   Text="TP2"
                                   Grid.Column="2"
                                   Margin="5,0"
                                   VerticalAlignment="Center" />

                        <TextBox x:Name="txtTP2_officiel_Fi"
                                 Grid.Column="3"
                                 Margin="5,0"
                                 Height="25"
                                 Width="60"
                                 VerticalContentAlignment="Center"
