<Window x:Class="GestionServiceGeii.UI.Windows.ConfigurationEffectifs_GEII_2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionServiceGeii.UI.Windows"
        mc:Ignorable="d"
        Title="Configuration des effectifs en GEII-2"
        Height="504"
        Width="1000">

    <Window.Resources>
        <Style x:Key="EffectifTextBoxBase"
               TargetType="TextBox">
            <Setter Property="Width"
                    Value="50" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="Height"
                    Value="25" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Visibility"
                    Value="Collapsed" />
        </Style>

        <Style x:Key="EffectifParcoursTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource EffectifTextBoxBase}">
            <EventSetter Event="TextChanged"
                         Handler="EffectifParcours_TextChanged" />
        </Style>

        <Style x:Key="EffectifTPTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource EffectifTextBoxBase}" />
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="lblFormationName"
                   Text="GEII-2"
                   Grid.Row="0"
                   Grid.Column="0"
                   Grid.ColumnSpan="3"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontFamily="Segoe UI"
                   FontSize="18"
                   FontStyle="Italic"
                   FontWeight="Bold" />
        <Grid x:Name="pnlFi"
              Visibility="Visible"
              d:Visibility="Collapsed"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <GroupBox x:Name="grpParcoursGEII_2_Fi"
                          Header="Configuration des parcours de spécialité"
                          Grid.Row="0"
                          Height="170"
                          Margin="5"
                          VerticalAlignment="Center"
                          Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="15" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="lblParcoursGEII_2_Fi"
                                   Text="Effectif :"
                                   Grid.Column="0"
                                   Grid.Row="0"
                                   HorizontalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="14" />

                        <TextBox x:Name="txtNbEtudiantsFi"
                                 Grid.Column="2"
                                 Grid.Row="0"
                                 Width="100"
                                 Height="25"
                                 HorizontalContentAlignment="Center"
                                 VerticalContentAlignment="Center" />

                        <CheckBox x:Name="chkParcoursEseFi"
                                  Grid.Column="0"
                                  Grid.Row="2"
                                  Content="ESE_FI"
                                  VerticalAlignment="Center" />

                        <TextBox x:Name="txtNbEtudiantsEseFi"
                                 Grid.Column="2"
                                 Grid.Row="2">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource EffectifParcoursTextBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkParcoursEseFi}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <CheckBox x:Name="chkParcoursEmeFi"
                                  Grid.Column="0"
                                  Grid.Row="3"
                                  Content="EME_FI"
                                  VerticalAlignment="Center" />

                        <TextBox x:Name="txtNbEtudiantsEmeFi"
                                 Grid.Column="2"
                                 Grid.Row="3">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource EffectifParcoursTextBox}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked, ElementName=chkParcoursEmeFi}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <CheckBox x:Name="chkParcoursAiiFi"
                                  Grid.Column="0"
                                  Grid.Row="4"
                                  Content="AII_FI"
                                  VerticalAlignment="Center" />

                        <TextBox x:Name="txtNbEtudiantsAiiFi"
                                 Grid.Column="2"
                                 Grid.Row="4">
