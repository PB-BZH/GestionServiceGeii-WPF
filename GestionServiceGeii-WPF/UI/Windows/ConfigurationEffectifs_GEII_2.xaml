                          Margin="5"
                          VerticalAlignment="Center"
                          Grid.Column="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="txtTd1_Fi"
                                   Text="TD1"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Row="0"
                                    Grid.Column="2"
                                    Margin="5,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                            <CheckBox x:Name="ChkESE_Fi"
                                      Content="ESE"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkEME_Fi"
                                      Content="EME"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkAII_Fi"
                                      Content="AII"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged    "
                                      Margin="10,0,0,0"
                                      VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Text="Effectif : "
                                   Grid.Row="0"
                                   Grid.Column="4"
                                   VerticalAlignment="Center" />

                        <TextBox x:Name="txtTotalTD1_Fi"
                                 Grid.Row="0"
                                 Width="Auto"
                                 Grid.Column="6"
                                 VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center" />

                        <TextBox x:Name="txtTd2_Fi"
                                 Text="TD2"
                                 Grid.Row="1"
                                 Grid.Column="0"
                                 VerticalAlignment="Center" />
                        <StackPanel Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    Margin="5,0"
                                    Grid.Column="2"
                                    Orientation="Horizontal">
                            <CheckBox x:Name="ChkESE_2_Fi"
                                      Content="ESE"
                                      Margin="0,0,10,0"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkEME_2_Fi"
                                      Content="EME"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkAII_2_Fi"
                                      Content="AII"
                                      Margin="10,0,0,0"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Effectif : "
                                   Grid.Row="1"
                                   Grid.Column="4"
                                   VerticalAlignment="Center" />

                        <TextBox x:Name="txtTotalTD2_Fi"
                                 Grid.Row="1"
                                 Grid.Column="6"
                                 Width="Auto"
                                 VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center" />

                        <TextBox x:Name="txtTd3_Fi"
                                 Text="TD3"
                                 Grid.Row="2"
                                 Grid.Column="0"
                                 VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Margin="5,0"
                                    Grid.Column="2"
                                    Orientation="Horizontal">
                            <CheckBox x:Name="ChkESE_3_Fi"
                                      Content="ESE"
                                      Margin="0,0,10,0"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkEME_3_Fi"
                                      Content="EME"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkAII_3_Fi"
                                      Content="AII"
                                      Margin="10,0,0,0"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Effectif : "
                                   Grid.Row="2"
                                   Grid.Column="4"
                                   VerticalAlignment="Center" />

                        <TextBox x:Name="txtTotalTD3_Fi"
                                 Grid.Row="2"
                                 Grid.Column="6"
                                 Width="Auto"
                                 VerticalAlignment="Center"
                                 HorizontalContentAlignment="Center" />

                    </Grid>
                </GroupBox>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="250" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <GroupBox x:Name="grpTPGroup_Fi"
                          Header="Groupes TP communs"
                          Grid.Row="0"
                          Margin="5"
                          Grid.Column="2">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="spEse21_Fi"
                                    Orientation="Horizontal"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Visibility="Collapsed"
                                    d:Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="tbkTpCommunEse21_Fi"
                                           Text="ESE21_Fi"
                                           Grid.Column="0"
                                           Grid.Row="0"
                                           Margin="5,0"
                                           VerticalAlignment="Center" />

                                <CheckBox x:Name="chkTP11_Fi"
                                          Content="TP1"
                                          Grid.Column="1"
                                          Grid.Row="0"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <CheckBox x:Name="chkTP21_Fi"
                                          Content="TP2"
                                          Grid.Column="2"
                                          Grid.Row="0"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <CheckBox x:Name="chkTP31_Fi"
                                          Content="TP3"
                                          Grid.Column="3"
                                          Grid.Row="0"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <TextBox x:Name="txtTpCommunEse21_Fi"
                                         Grid.Column="4"
                                         Grid.Row="0"
                                         Style="{StaticResource EffectifTextBoxBase}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="spEse22_Fi"
                                    Orientation="Horizontal"
                                    Grid.Row="1"
                                    Visibility="Collapsed"
                                    d:Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="tbkTpCommunEse22_Fi"
                                           Text="ESE22_Fi"
                                           Grid.Column="0"
                                           Grid.Row="1"
                                           Margin="5,0"
                                           VerticalAlignment="Center" />
                                <CheckBox x:Name="chkTP12_Fi"
                                          Content="TP1"
                                          Grid.Column="1"
                                          Grid.Row="1"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <CheckBox x:Name="chkTP22_Fi"
                                          Content="TP2"
                                          Grid.Column="2"
                                          Grid.Row="1"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <CheckBox x:Name="chkTP32_Fi"
                                          Content="TP3"
                                          Grid.Column="3"
                                          Grid.Row="1"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <TextBox x:Name="txtTpCommunEse22_Fi"
                                         Grid.Column="4"
                                         Grid.Row="1"
                                         Style="{StaticResource EffectifTextBoxBase}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="spEme21_Fi"
                                    Orientation="Horizontal"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Visibility="Collapsed"
                                    d:Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="tbkTpCommunEme21_Fi"
                                           Text="EME21_Fi"
                                           Grid.Column="0"
                                           Grid.Row="2"
                                           Margin="5,0"
                                           VerticalAlignment="Center" />

                                <CheckBox x:Name="chkTP13_Fi"
                                          Content="TP1"
                                          Grid.Column="1"
                                          Grid.Row="2"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <CheckBox x:Name="chkTP23_Fi"
                                          Content="TP2"
                                          Grid.Column="2"
                                          Grid.Row="2"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <CheckBox x:Name="chkTP33_Fi"
                                          Content="TP3"
                                          Grid.Column="3"
                                          Grid.Row="2"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <TextBox x:Name="txtTpCommunEme21_Fi"
                                         Grid.Column="4"
                                         Grid.Row="2"
                                         Style="{StaticResource EffectifTextBoxBase}" />
                            </Grid>
                        </StackPanel>

