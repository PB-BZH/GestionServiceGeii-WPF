                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="tbkTpCommunEme22_Fi"
                                           Text="EME22_Fi"
                                           Grid.Column="0"
                                           Grid.Row="3"
                                           Margin="5,0"
                                           VerticalAlignment="Center" />

                                <CheckBox x:Name="chkTP14_Fi"
                                          Content="TP1"
                                          Grid.Column="1"
                                          Grid.Row="3"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <CheckBox x:Name="chkTP24_Fi"
                                          Content="TP2"
                                          Grid.Column="2"
                                          Grid.Row="3"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <CheckBox x:Name="chkTP34_Fi"
                                          Content="TP3"
                                          Grid.Column="3"
                                          Grid.Row="3"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <TextBox x:Name="txtTpCommunEme22_Fi"
                                         Grid.Column="4"
                                         Grid.Row="3"
                                         Style="{StaticResource EffectifTextBoxBase}" />
                            </Grid>

                        </StackPanel>

                        <StackPanel x:Name="spAii21_Fi"
                                    Orientation="Horizontal"
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Visibility="Collapsed"
                                    d:Visibility="Visible">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="tbkTpCommunAii21_Fi"
                                           Text="AII21_Fi"
                                           Grid.Column="0"
                                           Grid.Row="4"
                                           Margin="5,0"
                                           VerticalAlignment="Center" />

                                <CheckBox x:Name="chkTP15_Fi"
                                          Content="TP1"
                                          Grid.Column="1"
                                          Grid.Row="4"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <CheckBox x:Name="chkTP25_Fi"
                                          Content="TP2"
                                          Grid.Column="2"
                                          Grid.Row="4"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <CheckBox x:Name="chkTP35_Fi"
                                          Content="TP3"
                                          Grid.Column="3"
                                          Grid.Row="4"
                                          Style="{StaticResource Effectif_Fi_CheckBox}" />

                                <TextBox x:Name="txtTpCommunAii21_Fi"
                                         Grid.Column="4"
                                         Grid.Row="4"
                                         Style="{StaticResource EffectifTextBoxBase}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="spAii22_Fi"
                                    Orientation="Horizontal"
                                    Grid.Row="5"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="4"
                                    Visibility="Collapsed"
                                    d:Visibility="Visible">
                            <Grid>
