                                 Grid.Row="2"
                                 Grid.Column="0"
                                 Width="50"
                                 VerticalAlignment="Center" />
                        <StackPanel Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Margin="5,0"
                                    Grid.Column="2"
                                    Orientation="Horizontal">
                            <CheckBox x:Name="ChkESE_3"
                                      Content="ESE"
                                      Margin="0,0,10,0"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkEME_3"
                                      Content="EME"
                                      Checked="GroupeTD_CheckedChanged"
                                      Unchecked="GroupeTD_CheckedChanged"
                                      VerticalAlignment="Center" />
                            <CheckBox x:Name="ChkAII_3"
                                      Content="AII"
                                      Margin="10,0,0,0"
