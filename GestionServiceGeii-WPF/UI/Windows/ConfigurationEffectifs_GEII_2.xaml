<Window x:Class="GestionServiceGeii.UI.Windows.ConfigurationEffectifs_GEII_2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionServiceGeii.UI.Windows"
        mc:Ignorable="d"
        Title="Configuration des effectifs en GEII-2"
        Height="420"
        Width="1000">

    <Window.Resources>

        <Style x:Key="EffectifTextBoxBase"
               TargetType="TextBox">
            <Setter Property="Width"
                    Value="50" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="Height"
                    Value="25" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Visibility"
                    Value="Collapsed" />
        </Style>

        <Style x:Key="EffectifParcoursTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource EffectifTextBoxBase}">
            <EventSetter Event="TextChanged"
                         Handler="EffectifParcoursFi_TextChanged" />
        </Style>

        <Style x:Key="EffectifTPTextBox"
               TargetType="TextBox"
               BasedOn="{StaticResource EffectifTextBoxBase}" />

    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="lblFormationName"
               Text="GEII-2"
               Grid.Row="0"
               Grid.Column="0"
               Grid.ColumnSpan="3"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               FontFamily="Segoe UI"
               FontSize="18"
               FontStyle="Italic"
               FontWeight="Bold" />
        <Grid x:Name="pnlFi"
              Visibility="Visible"
              d:Visibility="Visible"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox x:Name="grpParcoursGEII_2_Fi"
                      Header="Configuration des parcours de spécialité"
                      Grid.Row="1"
                      Margin="5"
                      VerticalAlignment="Center"
                      Grid.Column="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="15" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="lblParcoursGEII_2_Fi"
                           Text="Effectif :"
                           Grid.Column="0"
                           Grid.Row="0"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           FontSize="14" />

                    <TextBox x:Name="txtNbEtudiantsFi"
                             Grid.Column="2"
                             Grid.Row="0"
                             Width="100"
                             Height="25"
                             HorizontalContentAlignment="Center"
                             VerticalContentAlignment="Center" />

                    <CheckBox x:Name="chkParcoursEseFi"
                              Grid.Column="0"
                              Grid.Row="2"
                              Content="ESE__FI"
                              VerticalAlignment="Center" />

                    <TextBox x:Name="txtNbEtudiantsEseFi"
                             Grid.Column="2"
                             Grid.Row="2">
                        <TextBox.Style>
                            <Style TargetType="TextBox"
                                   BasedOn="{StaticResource EffectifParcoursTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkParcoursEseFi}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <CheckBox x:Name="chkParcoursEmeFi"
                              Grid.Column="0"
                              Grid.Row="3"
                              Content="EME__FI"
                              VerticalAlignment="Center" />

                    <TextBox x:Name="txtNbEtudiantsEmeFi"
                             Grid.Column="2"
                             Grid.Row="3">
                        <TextBox.Style>
                            <Style TargetType="TextBox"
                                   BasedOn="{StaticResource EffectifParcoursTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkParcoursEmeFi}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <CheckBox x:Name="chkParcoursAiiFi"
                              Grid.Column="0"
                              Grid.Row="4"
                              Content="AII__FI"
                              VerticalAlignment="Center" />

                    <TextBox x:Name="txtNbEtudiantsAiiFi"
                             Grid.Column="2"
                             Grid.Row="4">
                        <TextBox.Style>
                            <Style TargetType="TextBox"
                                   BasedOn="{StaticResource EffectifParcoursTextBox}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=chkParcoursAiiFi}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                </Grid>
            </GroupBox>
            <GroupBox x:Name="grpTPCommunGroup_Fi"
                      Header="Groupes TP communs"
                      Grid.Row="1"
                      Margin="5"
                      Grid.Column="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="tbkTpCommunEse21"
                           Text="ESE21_FI"
                           Grid.Column="0"
                           Grid.Row="0"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpCommunEse21"
                             Grid.Column="2"
                             Grid.Row="0"
                             Style="{StaticResource EffectifTextBoxBase}" />

                    <TextBlock x:Name="tbkTpCommunEse22"
                           Text="ESE22_FI"
                           Grid.Column="0"
                           Grid.Row="1"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpCommunEse22"
                             Grid.Column="2"
                             Grid.Row="1"
                             Style="{StaticResource EffectifTextBoxBase}" />

                    <TextBlock x:Name="tbkTpCommunEme21"
                           Text="EME21_FI"
                           Grid.Column="0"
                           Grid.Row="2"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpCommunEme21"
                             Grid.Column="2"
                             Grid.Row="2"
                             Style="{StaticResource EffectifTextBoxBase}" />

                    <TextBlock x:Name="tbkTpCommunEme22"
                           Text="EME22_FI"
                           Grid.Column="0"
                           Grid.Row="3"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpCommunEme22"
                             Grid.Column="2"
                             Grid.Row="3"
                             Style="{StaticResource EffectifTextBoxBase}" />

                    <TextBlock x:Name="tbkTpCommunAii21"
                           Text="AII21_FI"
                           Grid.Column="0"
                           Grid.Row="4"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpCommunAii21"
                             Grid.Column="2"
                             Grid.Row="4"
                             Style="{StaticResource EffectifTextBoxBase}" />

                    <TextBlock x:Name="tbkTpCommunAii22"
                           Text="AII22_FI"
                           Grid.Column="0"
                           Grid.Row="5"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpCommunAii22"
                             Grid.Column="2"
                             Grid.Row="5"
                             Style="{StaticResource EffectifTextBoxBase}" />
                    
                </Grid>
            </GroupBox>
            <GroupBox x:Name="grpTPSpecializedGroup_Fi"
                      Header="Groupes TP spécialisés"
                      Margin="5"
                      Grid.Row="1"
                      Grid.Column="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                        <RowDefinition Height="32" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="tbkTpSpecialiséEse21"
                           Text="ESE21_FI"
                           Grid.Column="0"
                           Grid.Row="0"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpSpecialiséEse21"
                             Grid.Column="2"
                             Grid.Row="0"
                             Style="{StaticResource EffectifTextBoxBase}" />

                    <TextBlock x:Name="tbkTpSpecialiséEse22"
                           Text="ESE22_FI"
                           Grid.Column="0"
                           Grid.Row="1"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpSpecialiséEse22"
                             Grid.Column="2"
                             Grid.Row="1"
                             Style="{StaticResource EffectifTextBoxBase}" />

                    <TextBlock x:Name="tbkTpSpecialiséEme21"
                           Text="EME21_FI"
                           Grid.Column="0"
                           Grid.Row="2"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpSpecialiséEme21"
                             Grid.Column="2"
                             Grid.Row="2"
                             Style="{StaticResource EffectifTextBoxBase}" />

                    <TextBlock x:Name="tbkTpSpecialiséEme22"
                           Text="EME22_FI"
                           Grid.Column="0"
                           Grid.Row="3"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpSpecialiséEme22"
                             Grid.Column="2"
                             Grid.Row="3"
                             Style="{StaticResource EffectifTextBoxBase}" />

                    <TextBlock x:Name="tbkTpSpecialiséAii21"
                           Text="AII21_FI"
                           Grid.Column="0"
                           Grid.Row="4"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpSpecialiséAii21"
                             Grid.Column="2"
                             Grid.Row="4"
                             Style="{StaticResource EffectifTextBoxBase}" />

                    <TextBlock x:Name="tbkTpSpecialiséAii22"
                           Text="AII22_FI"
                           Grid.Column="0"
                           Grid.Row="5"
                           VerticalAlignment="Center" />

                    <TextBox x:Name="txtTpSpecialiséAii22"
                             Grid.Column="2"
                             Grid.Row="5"
                             Style="{StaticResource EffectifTextBoxBase}" />
                </Grid>
            </GroupBox>
        </Grid>
        <Grid x:Name="pnlFa"
              Visibility="Collapsed"
              d:Visibility="Collapsed"
              Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox x:Name="grpParcoursGEII_2_Fa"
                      Header="Configuration des parcours de spécialité"
                      Grid.Row="1"
                      Margin="5"
                      Grid.Column="0">
            </GroupBox>
            <StackPanel Orientation="Vertical"
                        Grid.Row="1"
                        Grid.Column="2">

                <GroupBox x:Name="grpTPCommunGroup_Fa"
                          Header="Groupes TP communs"
                          Grid.Row="1"
                          Margin="5"
                          Grid.Column="2">
                </GroupBox>
                <GroupBox x:Name="grpTPSpecializedGroup_Fa"
                          Header="Groupes TP spécialisés"
                          Margin="5"
                          Grid.Row="1"
                          Grid.Column="2">
                </GroupBox>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2"
              Grid.Column="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="chkFi"
                      Content="Formation initiale"
                      Grid.Row="0"
                      Checked="chkFi_Checked"
                      VerticalContentAlignment="Center"
                      Grid.Column="0" />

            <CheckBox x:Name="chkFa"
                      Content="Formation par apprentissage"
                      Grid.Row="1"
                      Checked="chkFa_Checked"
                      VerticalContentAlignment="Center"
                      Grid.Column="0" />
            <Button x:Name="btnSave"
                    Content="Enregistrer"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Width="100"
                    HorizontalAlignment="Right"
                    Click="btnSave_Click"
                    Height="30"
                    Margin="5" />
        </Grid>

    </Grid>
</Window>
