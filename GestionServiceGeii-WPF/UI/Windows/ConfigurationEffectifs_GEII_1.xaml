<Window x:Class="GestionServiceGeii.UI.Windows.ConfigurationEffectifs_GEII_1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionServiceGeii.UI.Windows"
        mc:Ignorable="d"
        Title="Configuration des effectifs en GEII-1"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>
        <Label x:Name="nomDeLaFormation"
               Content="Formation"
               Grid.Row="0"
               Grid.Column="0"
               Grid.ColumnSpan="3"
               VerticalAlignment="Center"
               HorizontalAlignment="Center"
               FontFamily="Segoe UI"
               FontSize="18"
               FontStyle="Italic"
               FontWeight="Bold" />
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!--Coté gauche-->
                <ColumnDefinition Width="*" />
                <!--Coté droit-->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--Coté gauche-->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="70" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Label Content="Effectif prévu :"
                       Grid.Row="0"
                       Grid.Column="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       FontWeight="Bold" />

                <TextBox x:Name="saisieEffectif"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="25"
                         Width="100"
                         VerticalContentAlignment="Center"
                         HorizontalContentAlignment="Center" />

                <Label Content="Effectif par groupes de TP :"
                       Grid.Row="1"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom"
                       FontFamily="Segoe UI"
                       FontSize="18"
                       FontWeight="Bold" />

                <CheckBox x:Name="choixMax12"
                          Content="Groupes de 12"
                          Grid.Row="2"
                          Grid.Column="0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          FontFamily="Segoe UI"
                          FontSize="14"
                          Checked="ChoixMax12_CheckedChanged"
                          FontWeight="Bold" />

                <CheckBox x:Name="choixMax14"
                          Content="Groupes de 14"
                          Grid.Row="2"
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          FontFamily="Segoe UI"
                          FontSize="14"
                          Checked="ChoixMax14_CheckedChanged"
                          FontWeight="Bold" />

                <CheckBox x:Name="EffacerFenêtre"
                          Content="Effacer la fenêtre"
                          Grid.Row="4"
                          Grid.Column="0"
                          Grid.ColumnSpan="2"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          FontFamily="Segoe UI"
                          FontSize="14"
                          Checked="EffacerFenêtre_CheckedChanged"
                          FontWeight="Bold" />
            </Grid>

            <!--Coté Droit -->
            <Grid Grid.Column="1">
                <RichTextBox x:Name="fenetreRésumé"
                             Grid.Column="1"
                             Grid.Row="0"
                             IsReadOnly="True"
                             VerticalContentAlignment="Top"
                             HorizontalContentAlignment="Stretch" />
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10,0">

            <Button x:Name="boutonGroupeConfig"
                    Content="Groupe"
                    Margin="5,0"
                    Width="80"
                    Height="25"
                    Click="BoutonGroupeConfig_Click" />

            <Button x:Name="boutonValiderConfig"
                    Content="Valider"
                    Margin="5,0"
                    Width="80"
                    Height="25"
                    Click="BoutonValiderConfig_Click" />

        </StackPanel>

    </Grid>

</Window>
