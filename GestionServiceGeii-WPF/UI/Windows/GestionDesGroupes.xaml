<Window x:Class="GestionServiceGeii.UI.Windows.GestionDesGroupes"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionServiceGeii.UI.Windows"
        mc:Ignorable="d"
        Title="Gestion des groupes"
        Height="300"
        Width="350"
        ContentRendered="Window_ContentRendered">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="32" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
        </Grid.RowDefinitions>
        <Label Content="Type de séance"
               Grid.Row="1"
               Grid.Column="0"
               VerticalAlignment="Center"
               HorizontalAlignment="Center" />

        <Label Content="Choix du groupe"
               Grid.Row="1"
               Grid.Column="2"
               VerticalAlignment="Center"
               HorizontalAlignment="Center" />

        <Grid Grid.Column="0"
              Grid.Row="3"
              HorizontalAlignment="Center"
              Margin="20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <CheckBox x:Name="ckBoxCours"
                      Content="Cours"
                      VerticalAlignment="Center"
                      Checked="CkBoxCours_CheckedChanged"
                      Grid.Row="0" />

            <CheckBox x:Name="ckBoxTD"
                      Content="TD"
                      VerticalAlignment="Center"
                      Checked="CkBoxTD_CheckedChanged"
                      Grid.Row="1" />

            <CheckBox x:Name="ckBoxTP"
                      Content="TP"
                      VerticalAlignment="Center"
                      Checked="CkBoxTP_CheckedChanged"
                      Grid.Row="2" />
        </Grid>

        <ComboBox x:Name="CbChoixGroupe"
                  Margin="20,0"
                  Grid.Row="3"
                  Grid.Column="2"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  VerticalContentAlignment="Center"
                  Width="150" />

        <Button x:Name="validationTypeDeCours"
                Content="Valider"
                Grid.Row="4"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Center"
                Click="ValidationTypeDeCours_Click"
                Width="100"
                Height="25" />

    </Grid>
</Window>
