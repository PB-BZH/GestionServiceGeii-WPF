<Window x:Class="GestionServiceGeii.UI.Windows.GestionIntervenants"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionServiceGeii.UI.Windows"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Gestion des intervenants"
        Height="350"
        Width="610">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="40" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>
        <GroupBox x:Name="gpbAddAndUpdate"
                  Header="Intervenant à ajouter ou à mettre à jour"
                  Grid.Row="0"
                  Grid.Column="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label x:Name="lblName"
                       Content="Nom :"
                       Grid.Row="0"
                       Grid.Column="0" />

                <TextBox x:Name="txtName"
                         Grid.Row="0"
                         Height="23"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         Grid.Column="2" />

                <Label x:Name="lblFirstName"
                       Content="Prénom :"
                       Grid.Row="1"
                       Grid.Column="0" />

                <TextBox x:Name="txtFirstName"
                         Grid.Row="1"
                         Height="23"
                         VerticalContentAlignment="Center"
                         VerticalAlignment="Center"
                         Grid.Column="2" />

                <Label x:Name="lblStatus"
                       Content="Statut :"
                       Grid.Row="2"
                       Grid.Column="0" />

                <ComboBox x:Name="cmbStatus"
                          Grid.Row="2"
                          Height="23"
                          VerticalContentAlignment="Center"
                          VerticalAlignment="Center"
                          Grid.Column="2">
                    <sys:String>PR</sys:String>
                    <sys:String>MCF</sys:String>
                    <sys:String>PRAG</sys:String>
                    <sys:String>PRCE</sys:String>
                    <sys:String>Vacataire</sys:String>
                </ComboBox>

            </Grid>
        </GroupBox>
        <GroupBox x:Name="gpbActualPersonnal"
                  Header="Intervenants actuels en GEII"
                  Grid.Row="0"
                  Grid.Column="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label x:Name="lblTitulaires"
                       Content="Titulaires :"
                       Grid.Row="0"
                       Grid.Column="0" />

                <ComboBox x:Name="cmbTitulaires"
                          Grid.Row="0"
                          Height="23"
                          VerticalContentAlignment="Center"
                          SelectionChanged="cmbTitulaires_SelectionChanged" 
                          VerticalAlignment="Center"
                          Grid.Column="2" />

                <Label x:Name="lblVacataires"
                       Content="Vacataires :"
                       Grid.Row="1"
                       Grid.Column="0" />

                <ComboBox x:Name="cmbVacataires"
                          Grid.Row="1"
                          Height="23"
                          VerticalContentAlignment="Center"
                          SelectionChanged="cmbVacataires_SelectionChanged"
                          VerticalAlignment="Center"
                          Grid.Column="2" />

                <Label x:Name="lblchoice"
                       Content="Choix :"
                       Grid.Row="2"
                       Grid.Column="0" />
                <StackPanel Grid.Row="2"
                            Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox x:Name="chkTitulaire"
                              Content="Titulaire"
                              Checked="chkTitulaire_CheckedChanged"
                              Margin="0,0,20,0" />
                    <CheckBox x:Name="chkVacataire"
                              Content="Vacataires"
                              Checked="chkVacataire_CheckedChanged"
                              Margin="20,0,0,0" />
                </StackPanel>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="gpbActions"
                  Header="Actions"
                  Grid.Row="1"
                  Grid.Column="0"
                  Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Button x:Name="btnAddOrUpdate"
                        Content="Ajouter / Mettre à jour"
                        Width="150"
                        Height="25"
                        Margin="0,0,10,0"
                        Click="btnAddUpdate_Click" />
                <Button x:Name="btnDeleteIntervenant"
                        Content="Supprimer Intervenant"
                        Width="150"
                        Height="25"
                        Margin="10,0,10,0"
                        Click="btnDeleteIntervenant_Click" />
                <Button x:Name="btnGenerateStatus"
                        Content="Régénérer les statuts"
                        Width="150"
                        Height="25"
                        Margin="10,0,0,0"
                        Click="btnGenerateStatus_Click" />
            </StackPanel>
        </GroupBox>
        <Grid Grid.Row="2"
              Grid.Column="0"
              Grid.ColumnSpan="3">
            <Button x:Name="btnOk"
                    Content="OK"
                    Width="80"
                    Height="25"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="btnOK_Click" />
        </Grid>
        <StatusBar Grid.Row="3"
                   Grid.Column="0"
                   Grid.ColumnSpan="3">
            <StatusBarItem>
                <Label x:Name="txtMessage"
                       Content="Message"
                       Grid.Row="0"
                       VerticalAlignment="Center"
                       Grid.Column="0" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
