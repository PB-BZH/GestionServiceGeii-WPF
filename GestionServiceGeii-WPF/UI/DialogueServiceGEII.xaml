                                  Grid.Column="2"
                                  SelectionChanged="cmbIntervenantFicheService_SelectionChanged"
                                  Height="25" />

                        <Label x:Name="lblFichesStatut"
                               Content="Status :"
                               Grid.Row="1"
                               Grid.Column="4" />

                        <ComboBox x:Name="cmbStatutFicheService"
                                  Grid.Row="1"
                                  Grid.Column="6"
                                  Height="25">
                            <sys:String>PR</sys:String>
                            <sys:String>MCF</sys:String>
                            <sys:String>PRAG</sys:String>
                            <sys:String>PRCE</sys:String>
                            <sys:String>Vacataire</sys:String>
                        </ComboBox>

                        <Label x:Name="lblAcademicYear"
                               Content="Année universitaire :"
                               Grid.Row="1"
                               Grid.Column="8" />

                        <TextBox x:Name="txtAcademicYear"
                                 Grid.Row="1"
                                 Grid.Column="10"
                                 Height="25"
                                 VerticalContentAlignment="Center" />

                    </Grid>
                </Grid>

                <!--Fiche de service-->
                <RichTextBox x:Name="rtbFicheService"
                             Grid.Row="1"
                             Margin="5,5,5,5"
                             IsReadOnly="True"
                             VerticalContentAlignment="Top"
                             HorizontalContentAlignment="Stretch"
                             Grid.ColumnSpan="2">

                    <FlowDocument ColumnWidth="1000">
                        <Paragraph Margin="0">
                            <Run Text="Sélectionnez un intervenant et un statut pour afficher la fiche de service prévisionnelle." />
                        </Paragraph>
                    </FlowDocument>

                </RichTextBox>

                <!--Boutons-->
                <Grid Grid.Row="2"
                      Grid.ColumnSpan="2">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left">

                        <Button x:Name="btnGestionService"
                                Content="Gestion des services"
                                Width="Auto"
                                Height="25"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Margin="5"
                                Click="btnGestionService_Click" />

                        <Button x:Name="btnGestionDesIntervenants"
                                Content="Gestion des intervenants"
                                Width="Auto"
                                Height="25"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Margin="5"
                                Click="btnGestionDesIntervenants_Click" />

                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="btnCreateServiceFiche"
                                Content="Créer les fiches de service"
                                Height="25"
                                Width="Auto"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Click="btnCreateServiceFiche_Click"
                                Margin="5" />

                        <Button x:Name="btnImprimerFicheService"
                                Content="Imprimer"
                                Width="Auto"
                                Height="25"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Margin="5"
                                Click="btnImprimerFicheService_Click" />

                        <Button x:Name="btnExporterFicheService"
                                Height="25"
                                Content="Exporter"
                                Width="Auto"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Margin="5"
                                Click="btnExporterFicheService_Click" />

                        <Button x:Name="btnActualiserFicheService"
                                Content="Actualiser"
                                Width="Auto"
                                Height="25"
                                Padding="5,0"
                                VerticalContentAlignment="Center"
                                Margin="5,0"
                                Click="btnActualiserFicheService_Click" />

                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
        <StatusBar Grid.Row="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- GEII-1 : occupe les deux lignes -->
                <Border Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        Background="DarkOrange"
                        Padding="6,2"
                        VerticalAlignment="Stretch">
                    <TextBlock x:Name="étatTitreEffectif_Geii1"
                               Text="Effectif Geii1 :"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="étatEffectif_Geii1"
                           Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="1"
                           Text="0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTD_Geii1"
                           Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="2"
                           Text="TD : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTP_Geii1"
                           Grid.Row="0"
                           Grid.RowSpan="2"
                           Grid.Column="3"
                           Text="TP : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <!-- GEII-2 FI : première ligne -->
                <Border Grid.Row="0"
                        Grid.Column="5"
                        Background="DarkOrchid"
                        Padding="6,2">
                    <TextBlock x:Name="étatTitreEffectif_Geii2_FI"
                               Text="Effectif Geii2 FI :"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="étatEffectif_Geii2_FI"
                           Grid.Row="0"
                           Grid.Column="6"
                           Text="0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTD_Geii2_FI"
                           Grid.Row="0"
                           Grid.Column="7"
                           Text="TD : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTP_Geii2_FI"
                           Grid.Row="0"
                           Grid.Column="8"
                           Text="TP : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTPSp_Geii2_FI"
                           Grid.Row="0"
                           Grid.Column="9"
                           Text="TPSp : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <!-- GEII-2 FA : deuxième ligne -->
                <Border Grid.Row="1"
                        Grid.Column="5"
                        Background="DarkSeaGreen"
                        Padding="6,2">
                    <TextBlock x:Name="étatTitreEffectif_Geii2_FA"
                               Text="Effectif Geii2 FA :"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="étatEffectif_Geii2_FA"
                           Grid.Row="1"
                           Grid.Column="6"
                           Text="0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTD_Geii2_FA"
                           Grid.Row="1"
                           Grid.Column="7"
                           Text="TD : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTP_Geii2_FA"
                           Grid.Row="1"
                           Grid.Column="8"
                           Text="TP : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTPSp_Geii2_FA"
                           Grid.Row="1"
                           Grid.Column="9"
                           Text="TPSp : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <!-- GEII-1 : occupe les deux lignes -->
                <Border Grid.Row="0"
                        Grid.Column="11"
                        Background="DeepSkyBlue"
                        Padding="6,2"
                        VerticalAlignment="Stretch">
                    <TextBlock x:Name="étatTitreEffectif_Geii2_Mutuel"
                               Text="Geii2 Mutualisé :"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock x:Name="étatEffectif_Geii2_Mutuel"
                           Grid.Row="0"
                           Grid.Column="12"
                           Text="0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTD_Geii2_Mutuel"
                           Grid.Row="0"
                           Grid.Column="13"
                           Text="TD : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTP_Geii2_Mutuel"
                           Grid.Row="0"
                           Grid.Column="14"
                           Text="TP : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />

                <TextBlock x:Name="étatNbGroupeTPSp_Geii2_Mutuel"
                           Grid.Row="0"
                           Grid.Column="15"
                           Text="TPSp : 0"
                           Margin="8,0"
                           VerticalAlignment="Center" />


            </Grid>
        </StatusBar>
    </Grid>
</Window>

