                                       Grid.Column="6"
                                       VerticalAlignment="Center" />

                                <CheckBox x:Name="chkMutualisation"
                                          Content="Mutualisation des cours"
                                          VerticalAlignment="Center"
                                          Grid.Row="5"
                                          Checked="chkMutualisation_Checked"
                                          Unchecked="chkMutualisation_Checked"
                                          Grid.ColumnSpan="3" />

                                <Button x:Name="modifierFicheMatière"
                                        Content="Modifier la fiche matière"
                                        Grid.Row="6"
                                        Grid.ColumnSpan="7"
                                        HorizontalAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Height="25"
                                        Width="180"
                                        Click="ModifierFicheMatière_Click" />
                            </Grid>
