                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="5" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0"
                                  Header="Fiche matière"
                                  FontWeight="Bold">
                            <Grid Margin="10"
                                  HorizontalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="25" />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Label x:Name="Matière"
                                       Content="Matière :"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />

                                <Label x:Name="texteMatière"
                                       Content="texteMatière"
                                       Grid.Row="0"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold" />

                                <Label Content="CM : "
                                       Grid.Row="0"
                                       Grid.Column="4"
                                       VerticalAlignment="Center" />

                                <Label x:Name="valeur_CM"
                                       Content="0"
                                       Grid.Row="0"
                                       Grid.Column="6"
                                       VerticalAlignment="Center" />

                                <Label Content="OSE :"
                                       Grid.Row="1"
                                       Grid.Column="0"
                                       VerticalAlignment="Center" />

                                <Label x:Name="txtCodeOSE"
                                       Content="Code OSE"
                                       Grid.Row="1"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold" />

                                <Label Content="APP : "
                                       Grid.Row="1"
                                       Grid.Column="4"
                                       VerticalAlignment="Center" />

                                <Label x:Name="valeur_APP"
                                       Content="0"
                                       Grid.Row="1"
                                       Grid.Column="6"
                                       VerticalAlignment="Center" />

                                <Label Content="TD : "
                                       Grid.Row="2"
                                       Grid.Column="4"
                                       VerticalAlignment="Center" />

                                <Label x:Name="valeur_TD"
                                       Content="0"
                                       Grid.Row="2"
                                       Grid.Column="6"
                                       VerticalAlignment="Center" />

                                <Label Content="Module :"
                                       Grid.Row="4"
                                       Grid.Column="0"
                                       VerticalAlignment="TOP" />

                                <TextBox x:Name="texteLibelléModule"
                                         Text="Libellé module"
                                         Grid.Row="4"
                                         Grid.Column="2"
                                         Grid.ColumnSpan="5"
                                         TextWrapping="Wrap"
                                         Height="30"
                                         VerticalContentAlignment="Center"
                                         FontWeight="Bold" />

                                <Label Content="TP : "
                                       Grid.Row="3"
                                       Grid.Column="4"
                                       VerticalAlignment="Center" />

                                <Label x:Name="valeur_TP"
                                       Content="0"
