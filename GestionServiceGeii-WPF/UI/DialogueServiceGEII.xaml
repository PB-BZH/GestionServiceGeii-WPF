<Window x:Class="GestionServiceGeii.UI.DialogueServiceGEII"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GestionServiceGeii.UI"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        mc:Ignorable="d"
        Title="Gestion Service GEII"
        MinHeight="730"
        MinWidth="1300"
        Closing="DialogueServiceGEII_Closing"
        Height="756"
        Width="1406">

    <Window.Resources>

        <!-- Texte des cellules centré -->
        <Style x:Key="CellTextCentered"
               TargetType="TextBlock">
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.35" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>
        <Menu Grid.Row="0">
            <MenuItem Header="_Fichier">
                <MenuItem x:Name="menuOuvrirFichier"
                          Header="_Ouvrir"
                          Click="MenuOuvrirFichier_Click">
                </MenuItem>
                <Separator />
                <MenuItem x:Name="menuFichierEnregistrer"
                          Header="_Enregistrer"
                          Click="MenuFichierEnregistrer_Click">
                </MenuItem>
                <MenuItem x:Name="menuFichierEnregistrerSous"
                          Header="_Enregistrer sous ..."
                          Click="MenuFichierEnregistrerSous_Click">
                </MenuItem>
                <Separator />
                <MenuItem x:Name="menuFichierImprimer"
                          Header="_Imprimer"
                          Click="MenuImprimerFicheService_Click">
                </MenuItem>
                <MenuItem x:Name="menuFichierAperçuAvantImpression"
                          Header="_Aperçu avant impression"
                          Click="MenuApercuFicheService_Click">
                </MenuItem>
                <Separator />
                <MenuItem x:Name="MenuFichierRéinitialiserEnvironnement"
                          Header="_Réinitialiser environnement"
                          Click="MenuFichierRéinitialiserEnvironnement_Click">
                </MenuItem>
                <Separator />
                <MenuItem x:Name="mnuQuitter"
                          Header="_Quitter"
                          Click="mnuQuitter_Click">
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Edition">
                <MenuItem Header="_Annuler"
                          x:Name="MenuAnnuler"
                          Click="MenuAnnuler_Click" />
                <MenuItem Header="_Retablir"
                          x:Name="MenuRetablir"
                          Click="MenuRetablir_Click" />
                <Separator />
                <MenuItem Header="Couper"
                          x:Name="MenuCouper"
                          Click="MenuCouper_Click" />
                <MenuItem Header="Copier"
                          x:Name="MenuCopier"
                          Click="MenuCopier_Click" />
                <MenuItem Header="Coller"
                          x:Name="MenuColler"
                          Click="MenuColler_Click" />
                <Separator />
                <MenuItem Header="Sélectionner tout"
                          x:Name="MenuSelectionnerTout"
                          Click="MenuSelectionnerTout_Click" />
            </MenuItem>
            <MenuItem Header="_Configuration">
                <MenuItem Header="Afficher les critères de sélection"
                          x:Name="AfficherLesCritèresDeSélection"
                          Click="AfficherLesCritèresDeSélection_Click" />
                <MenuItem Header="EFfectif prévu"
                          x:Name="élémentMenuEffectifPrévu">
                    <MenuItem Header="Geii_1"
                              x:Name="élémentMenuGEII_1"
                              Click="MenuEffectifGeii_1_Click" />
                    <MenuItem Header="Geii_2"
                              x:Name="élémentMenuGEII2"
                              Click="MenuEffectifGeii_2_Click" />
                </MenuItem>
                <MenuItem Header="Gestion des intervenants"
                          x:Name="mnuGestionDesIntervenants"
                          Click="mnuGestionDesIntervenants_Click" />
                <MenuItem Header="Chemin d'accès"
                          x:Name="mnuCheminsAcces"
                          Click="mnuCheminsAcces_Click" />
            </MenuItem>
            <MenuItem Header="_Outils">
                <MenuItem x:Name="mnuVueGestionServices"
                          Header="Gestion des services"
                          IsCheckable="True"
                          Click="mnuVueGestionServices_Click" />
                <MenuItem x:Name="mnuVueFichesService"
                          Header="Fiches de service"
                          IsCheckable="True"
                          Click="mnuVueFichesService_Click" />
                <MenuItem x:Name="mnuGenererStatutsIntervenants"
                          Header="Générer status des intervenants"
                          Click="mnuGenererStatutsIntervenants_Click" />
                <MenuItem x:Name="mnuCleanCache"
                          Header="Effacer le cache"
                          Click="mnuCleanCache_Click" />
                <MenuItem x:Name="mnuMettreAJourSource"
                          Header="Mettre à jour souce"
                          Click="mnuMettreAJourSource_Click" />
                <MenuItem x:Name="mnuTest"
                          Header="Test"
                          Click="mnuTest_Click" />
            </MenuItem>
            <MenuItem Header="_Profils">
                <MenuItem x:Name="mnuOpenProfile"
                          Header="Ouvrir profil"
                          Click="mnuOpenProfile_Click" />
                <MenuItem x:Name="mnuSaveProfile"
                          Header="Enregistrer profil"
                          Click="mnuSaveProfile_Click" />
                <MenuItem x:Name="mnuSaveProfileAs"
                          Header="Enregistrer profil sous..."
                          Click="mnuSaveProfileAs_Click" />
                <MenuItem x:Name="mnuProfileStatus"
                          Header="Etat du profil"
                          Click="mnuProfileStatus_Click" />
                <MenuItem x:Name="mnuOpenLastProfile"
                          Header="Ouvrir le dernier profil"
                          Click="mnuOpenLastProfile_Click" />
                <MenuItem x:Name="mnuAutoOpenLastProfileOnStartup"
                          Header="Ouvrir le dernier profil au démarrage"
                          IsCheckable="True"
                          Click="mnuAutoOpenLastProfileOnStartup_Click" />
                <MenuItem x:Name="mnuloadProfil"
                          Header="Charger profil"
                          Click="mnuloadProfil_Click" />
            </MenuItem>
            <MenuItem Header="_Aide">
                <MenuItem x:Name="mnuAbout"
                          Header="A propos de Gestion de Service GEII"
                          Click="mnuAbout_Click" />
                <MenuItem x:Name="mnuCheckForUpdates"
                          Header="Recherche de mise à jour"
                          Click="mnuCheckForUpdates_Click" />
            </MenuItem>
        </Menu>
        <ToolBar Grid.Row="1">
            <!--Barre d'outils-->
        </ToolBar>
        <Grid Grid.Row="2"
              x:Name="pnlViewHost"
              Margin="10">
            <Grid x:Name="pnlGestionServices"
                  Visibility="Visible"
                  d:Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="64" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="500" />
                    </Grid.ColumnDefinitions>
                    <!-- Partie gauche -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="64" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0"
                              Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32" />
                                <RowDefinition Height="32" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Sélection feuille"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />

                            <ComboBox x:Name="FeuilleClasseur"
                                      Grid.Column="0"
                                      Grid.Row="1"
                                      Height="25" />

                            <TextBlock Text="Choix intervenant"
                                       Grid.Row="0"
                                       Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />

                            <ComboBox x:Name="Intervenants"
                                      Grid.Row="1"
                                      Height="25"
                                      Grid.Column="2" />

                            <TextBlock Text="Titulaires"
                                       Grid.Row="0"
                                       Grid.Column="4"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />

                            <ComboBox x:Name="Titulaires"
                                      Grid.Row="1"
                                      Height="25"
                                      Grid.Column="4" />

                            <TextBlock Text="Vacataires"
                                       Grid.Row="0"
                                       Grid.Column="6"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />

                            <ComboBox x:Name="Vacataires"
                                      Grid.Row="1"
                                      Height="25"
                                      Grid.Column="6" />

                            <TextBlock Text="Informations"
                                       Grid.Row="0"
                                       Grid.Column="8"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />

                            <ComboBox x:Name="INFOS"
                                      SelectionChanged="INFOS_SelectionChanged"
                                      Grid.Row="1"
                                      Height="25"
                                      Grid.Column="8" />

                            <TextBlock Text="OSE"
                                       Grid.Row="0"
                                       Grid.Column="10"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" />

                            <ComboBox x:Name="OSE"
                                      Grid.Row="1"
                                      Grid.Column="10"
                                      Height="25" />
                        </Grid>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="VisualisationDonnées"
                                      SelectionChanged="VisualisationDonnées_SelectionChanged"
                                      MouseLeftButtonUp="VisualisationDonnées_MouseLeftButtonUp"
                                      PreviewMouseLeftButtonDown="VisualisationDonnées_PreviewMouseLeftButtonDown"
                                      MouseDoubleClick="VisualisationDonnées_MouseDoubleClick"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="true"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      ColumnWidth="*"
                                      ColumnHeaderHeight="28"
                                      RowHeight="28">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Formation"
                                                        Binding="{Binding Formation}"
                                                        ElementStyle="{StaticResource CellTextCentered}" />

                                    <DataGridTextColumn Header="Module"
                                                        Binding="{Binding Module}"
                                                        ElementStyle="{StaticResource CellTextCentered}" />

                                    <DataGridTextColumn Header="Cours"
                                                        Binding="{Binding Cours}"
                                                        ElementStyle="{StaticResource CellTextCentered}" />

                                    <DataGridTextColumn Header="Noms"
                                                        Binding="{Binding Noms}"
                                                        ElementStyle="{StaticResource CellTextCentered}" />

                                    <DataGridTextColumn Header="Durée"
                                                        Binding="{Binding Durée}"
                                                        ElementStyle="{StaticResource CellTextCentered}" />

                                    <DataGridTextColumn Header="Nombre"
                                                        Binding="{Binding Nombre}"
                                                        ElementStyle="{StaticResource CellTextCentered}" />

                                    <DataGridTextColumn Header="Groupe"
                                                        Binding="{Binding Groupe}"
                                                        ElementStyle="{StaticResource CellTextCentered}" />

                                    <DataGridTextColumn Header="Total type"
                                                        Binding="{Binding Total_type}"
                                                        ElementStyle="{StaticResource CellTextCentered}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                    <!--Partie droite-->
                    <Grid x:Name="détailMatière"
                          Grid.Column="1"
                          Margin="10,0,10,0"
